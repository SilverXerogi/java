<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="create-users-table" author="Maksim">
        <createTable tableName="users">
            <column name="id" type="SERIAL" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)"> <!-- Хранить зашифрованным -->
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>

        <!-- Добавим тестовых пользователей -->
        <insert tableName="users">
            <column name="username" value="admin"/>
            <column name="password" value="$2a$10$gQcZ.zP5k8yQhR8Y.qx2qO5qHrU6yfK0JzWqFkLmNpO5qHrU6yfK0"/> <!-- bcrypt шифрование для 'admin123' -->
            <column name="role" value="ADMIN"/>
        </insert>
        <insert tableName="users">
            <column name="username" value="user"/>
            <column name="password" value="$2a$10$gQcZ.zP5k8yQhR8Y.qx2qO5qHrU6yfK0JzWqFkLmNpO5qHrU6yfK0"/> <!-- тот же пароль -->
            <column name="role" value="USER"/>
        </insert>
    </changeSet>
</databaseChangeLog>