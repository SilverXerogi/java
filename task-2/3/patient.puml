@startuml PatientDomainFixed

skinparam classAttributeIconSize 0

package "Clinic Domain" {
  abstract class Person {
    - id: String
    - firstName: String
    - lastName: String
    - birthDate: Date
    + getFullName(): String
    + getAge(): int
  }

  class Patient extends Person {
    - medicalRecordNumber: String           ' уникальный идентификатор пациента
    - primaryPhysicianId: String
    - contacts: List<ContactInfo>
    - visits: List<Visit>
    - medications: List<Medication>
    - medicalProfile: MedicalProfile
    + addAllergy(a: String): void
    + removeAllergy(a: String): void
    + getActiveMedications(): List<Medication>
    + addVisit(v: Visit): void
    + addMedication(m: Medication): void
    + getVisits(): List<Visit>
  }

  class MedicalProfile {
    - bloodType: int         
    - rhFactor: boolean      ' true = Rh+, false = Rh-
    - allergies: List<String>
    - chronicConditions: List<String>
    + addAllergy(a: String): void
    + hasAllergy(a: String): boolean
  }

  class ContactInfo {
    - id: String
    - patientId: String      ' ссылка на владельца
    - phone: String
    - email: String
    - address: Address
    + validateEmail(): boolean
    + normalizePhone(): String
  }

  class Address {
    - street: String
    - city: String
    - postalCode: String
    - country: String
    + toString(): String
  }

  class Visit {
    - visitId: String
    - patientId: String      ' явная ссылка на пациента
    - performedByStaffId: String
    - date: DateTime
    - reason: String
    - notes: String
    + addNote(note: String): void
    + closeVisit(): void
    + getDiagnoses(): List<Diagnosis>
  }

  class Medication {
    - medId: String
    - patientId: String       ' явная связь с пациентом
    - name: String
    - dosage: String
    - startDate: Date
    - endDate: Date
    + isActive(onDate: Date): boolean
    + discontinue(date: Date): void
  }

  class Diagnosis {
    - diagId: String
    - patientId: String
    - code: String
    - description: String
    - isChronic: boolean
    + markChronic(): void
  }

  class Staff extends Person {
    - staffId: String
    - role: StaffRole
    - canDiagnose: boolean
    - canTreat: boolean
    + assignToPatient(p: Patient): void
    + addDiagnosis(p: Patient, d: Diagnosis): void
    + attendVisit(v: Visit): void
  }

  enum StaffRole {
    DOCTOR
    NURSE
    ADMIN
    TECH
  }


  Patient "1" *-- "0..*" ContactInfo : contacts >
  ContactInfo o-- Address
  Patient "1" -- "0..*" Visit : visits >
  Visit "0..*" o-- "0..*" Staff : attendedBy >
  Visit "0..*" -- "0..*" Diagnosis : diagnoses >
  Patient "1" o-- "0..*" Medication : medications >
  Diagnosis "1" -- "1" Patient : patient >
  Medication "1" -- "1" Patient : patient >
  Person <|-- Patient
  Person <|-- Staff
}
@enduml
